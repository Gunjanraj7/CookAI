# CookAI configuration. Copy this file to `.env` (same folder) and fill in your values.
# Both the API and the web app read this one file. Never commit `.env`.

# ── App ───────────────────────────────────────────────────────────────────
# Name shown in the header, page titles and AI notes
APP_NAME=CookAI

# ── Servers ───────────────────────────────────────────────────────────────
API_PORT=5000
WEB_PORT=5173
# Origin the browser uses for the web app (CORS allow-list for the API; comma-separate several)
WEB_ORIGIN=http://localhost:5173

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# `npm run db:create` creates the database named here if it doesn't exist yet.
#
# Option A (default): a private instance just for CookAI, no password needed.
#   Start it with `npm run db:local:start`; data lives in ./.pgdata.
DATABASE_URL=postgres://postgres@localhost:5433/cookai
# Option B: your own PostgreSQL server. Replace the line above with e.g.
#   DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/cookai
# Max connections in the API's pool
DATABASE_POOL_MAX=10
# Only for Option A: PostgreSQL bin folder (auto-detected if empty) and data folder
PG_BIN=
PG_LOCAL_DATA=.pgdata

# ── AI recipe generation ──────────────────────────────────────────────────
# Which provider generates recipes: mock | gemini | openai | anthropic
# `mock` needs no key and returns a simple template recipe, so the app works out of the box.
AI_PROVIDER=mock

# Model for the chosen provider. Leave empty to use that provider's default below.
# Defaults: gemini → gemini-flash-latest, openai → gpt-5.5, anthropic → claude-opus-5-5
# Model names change often; check your provider's model list if a request fails.
AI_MODEL=

# Paste the key for the provider you picked; the others can stay as placeholders.
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Cuisine the AI leans towards when the user doesn't pick one
AI_DEFAULT_CUISINE=Indian
# Give up on a generation request after this many milliseconds
AI_TIMEOUT_MS=60000
# Anthropic only: reasoning effort (low | medium | high). Empty = model default.
AI_EFFORT=
